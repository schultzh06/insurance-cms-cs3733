# Backend env: copy to apps/backend/.env and fill in from the team's shared secrets.
# The same file serves local dev, the seed/backfill scripts and production: ./deploy.sh copies
# it to the host as-is. Routing (ports, API_URL, ML_SERVICE_URL) and the frontend's Auth0
# settings live in the stack's compose.yml in the Selfhosting repo, not here.

# Auth0: verifies API tokens
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Auth0 Management API (M2M app): creating/deleting users, and the seed's user sync
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Supabase Postgres
# Prisma CLI and the seed
DATABASE_URL=
# the app's Prisma client (same URL as DATABASE_URL)
NEXT_PUBLIC_DATABASE_URL=
# read-only role, used to run Insights' generated SQL
DATABASE_URL_READONLY=

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CONTENT_BUCKET=softeng-demo-content
R2_PROFILES_BUCKET=softeng-demo-profiles

# OpenRouter: Insights (NL→SQL) and image descriptions during text extraction
OPENROUTER_API_KEY=
# optional OpenRouter model id; empty = openai/gpt-5.4-mini
NL_QUERY_MODEL=
# optional; empty = google/gemini-2.5-flash-lite
IMAGE_DESCRIPTION_MODEL=

# Seed script only: password given to every demo Auth0 user
SEED_DEMO_PASSWORD=

# Optional, local dev: where the embedding server listens (default http://localhost:3001)
# ML_SERVICE_URL=
